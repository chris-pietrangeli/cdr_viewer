<% content_for :title, "Import ##{@import.id}" %>

<header class="page-header">
  <h1>Import #<%= @import.id %></h1>
</header>

<% if @import.success? %>
  <p class="summary">
    <% if @import.kind == "towers" %>
      <%= link_to pluralize(@import.imported_count, "tower"), towers_path %> imported,
    <% else %>
      <%= link_to pluralize(@import.imported_count, "call"), call_records_path(import_id: @import) %> imported,
    <% end %>
    <%= pluralize(@import.rejected_rows_count, "row") %> rejected.
  </p>
<% else %>
  <p class="alert">This file was not imported and nothing from it was saved. <%= @import.error %></p>
<% end %>

<dl class="details">
  <dt>File</dt>
  <dd><%= @import.filename %></dd>
  <dt>Contents</dt>
  <dd><%= @import.kind.capitalize %></dd>
  <dt>Received</dt>
  <dd><%= format_time(@import.created_at) %> UTC</dd>
  <dt>Size</dt>
  <dd><%= number_with_delimiter(@import.byte_size) %> bytes</dd>
  <% if @import.layout %>
    <dt>Column layout</dt>
    <dd><code><%= @import.layout %></code></dd>
  <% end %>
  <dt>SHA-256</dt>
  <dd><code><%= @import.sha256 %></code></dd>
  <% if @import.identical_uploads.any? %>
    <dt>Same file as</dt>
    <dd>
      <% @import.identical_uploads.each do |other| %>
        <%= link_to "Import ##{other.id}", other %> (<%= format_time(other.created_at) %> UTC)<br>
      <% end %>
    </dd>
  <% end %>
</dl>

<% if @rejected_rows.any? %>
  <h2>Rejected rows</h2>
  <table>
    <thead>
      <tr>
        <th class="numeric">Line</th>
        <th>Reason</th>
        <th>Row as it appears in the file</th>
      </tr>
    </thead>
    <tbody>
      <% @rejected_rows.each do |row| %>
        <tr>
          <td class="numeric"><%= row.line_number %></td>
          <td><%= row.reason %></td>
          <td><code><%= row.raw %></code></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
